{
	"preferredNotifChannel": "terminal_bell",
	"ignorePatterns": [
		".git/**", // internal Git files – never useful to the model
		"node_modules/",
	],
	"paths": {
		"allowedDirectories": [
			"/Users/aalrahma/personal/",
			"/Users/aalrahma/work/",
		],
		"excludedPatterns": [
			"**/.git/**",
			"**/node_modules/",
			"**/*.env",
			"**/*.key",
			"**/*.pem",
			"**/*.secret",
			"**/password*",
			"**/credentials*",
		],
	},
	"hooks": {"SessionStart": [{"hooks": [{
		"type":    "command",
		"command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
		"timeout": 5,
	}]}]},
}
